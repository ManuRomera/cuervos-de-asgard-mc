<div class="camc-chat-card {{tipo}} deity-{{actor.system.biografia.deidad}} {{#if critico}}critico{{/if}} {{#if pifia}}pifia{{/if}} {{#if exito}}exito{{/if}} {{#if dificultad}}{{#unless exito}}fallo{{/unless}}{{/if}}">
  <header>
    {{#if actor.img}}<img class="camc-chat-avatar" src="{{actor.img}}" alt=""/>{{/if}}
    <strong>{{actor.name}}</strong><span>{{tipo}}</span>
  </header>
  {{#if (eq tipo "tirada")}}
    <h3>{{skillLabel habilidad}}</h3>
    {{#if repeticionNota}}<div class="camc-reroll-note">{{{repeticionNota}}}</div>{{/if}}
    <div class="camc-roll-main">
      <div class="camc-roll-total"><span>Total</span><b>{{roll.total}}</b></div>
      {{#if dificultad}}<div class="camc-roll-state {{#if exito}}success{{else}}fail{{/if}}"><span>DF {{dificultad}}</span><b>{{#if exito}}Éxito{{else}}Fallo{{/if}}</b></div>{{/if}}
    </div>
    {{#if repetida}}<p class="camc-reroll-label"><i class="fas fa-rotate"></i> Dados de la tirada repetida:</p>{{/if}}
    <div class="camc-dice-faces">{{#each dice}}<span class="{{#if (eq this 6)}}six{{/if}}{{#if (eq this 1)}}one{{/if}}{{#if (lookup ../diceIsNew @index)}} rerolled{{/if}}">{{this}}</span>{{/each}}</div>
    <div class="mods">{{attrShort data.atributo}} {{data.bonificador}} {{#if data.favorecida}}· favorecida +3{{/if}} {{#if data.equipoBonus}}· equipo {{data.equipoBonus}}{{/if}} {{#if data.modificadorManual}}· mod {{data.modificadorManual}}{{/if}}</div>
    {{#if opciones.mount}}<div class="mods mount">Moto: <strong>{{opciones.mount.name}}</strong>{{#if opciones.mount.maniobrabilidad}} · Maniobrabilidad {{opciones.mount.maniobrabilidad}}{{/if}}{{#if opciones.mount.penalizadorDano}} · Dañada +{{opciones.mount.penalizadorDano}} DF{{/if}}</div>{{/if}}
    <div class="mods">Base {{data.baseDados}}D{{#if data.proezaDados}} · proezas +{{data.proezaDados}}D{{/if}}{{#if data.dadosExtra}} · ajuste {{data.dadosExtra}}D{{/if}}{{#if data.recuerdoCuando}} · Recuerdo cuando +{{data.recuerdoCuandoDados}}D{{/if}}{{#if data.saludPenalty}} · Salud {{data.saludPenalty}}D{{/if}}{{#if data.desenfundar}} · desenfundar/cambiar -1D{{/if}}{{#if data.dadosSacrificados}} · sacrificados -{{data.dadosSacrificados}}D{{/if}}</div>
    {{#if data.armaPreparada}}
    <div class="mods">Arma preparada: {{data.armaPreparada.label}}</div>
    {{#unless data.armaPreparada.desarmado}}{{#unless data.armaPreparada.equipada}}<div class="camc-equip-warning"><i class="fas fa-triangle-exclamation"></i> Arma no equipada: no influye en el resultado, pero avisa al DJ.</div>{{/unless}}{{/unless}}
    {{/if}}
    {{#if critico}}<div class="crit">CRÍTICO · gana 1 proeza</div>{{/if}}
    {{#if pifia}}<div class="fumble">PIFIA</div>{{/if}}
    {{#if danoInfo}}
    <div class="camc-impact-note"><i class="fas fa-hand-fist"></i> Impacto con <strong>{{danoInfo.itemName}}</strong>{{#if danoInfo.critico}} · daño doblado por crítico{{/if}}</div>
    <div class="camc-roll-main"><div class="camc-roll-total"><span>Daño</span><b>{{danoInfo.total}}</b></div></div>
    <button type="button" class="camc-chat-action" data-camc-action="apply-damage" data-damage="{{danoInfo.total}}">Aplicar daño</button>
    {{/if}}
    {{#if curaInfo}}
    <div class="camc-cura-note {{curaInfo.resultado}}">
      {{#if (eq curaInfo.resultado "critico")}}<i class="fas fa-star"></i> ¡Crítico! {{curaInfo.targetName}} recupera <strong>{{curaInfo.cantidad}}</strong> puntos de Salud.{{/if}}
      {{#if (eq curaInfo.resultado "exito")}}<i class="fas fa-kit-medical"></i> {{curaInfo.targetName}} recupera <strong>{{curaInfo.cantidad}}</strong> puntos de Salud.{{/if}}
      {{#if (eq curaInfo.resultado "pifia")}}<i class="fas fa-triangle-exclamation"></i> Pifia: {{curaInfo.targetName}} pierde <strong>1</strong> punto de Salud adicional.{{/if}}
      {{#if (eq curaInfo.resultado "sin_efecto")}}Sin efecto curativo esta vez.{{/if}}
      {{#if curaInfo.bonusBotiquin}}<br/><small>Botiquín de primeros auxilios: +1 punto extra incluido.</small>{{/if}}
      <br/><small>Solo un intento de Auxilio por herida concreta.</small>
    </div>
    {{/if}}
    {{#unless repetida}}
      {{#if defectoPendiente}}
      <div class="camc-chat-actions-row">
        <button type="button" class="camc-chat-action" data-camc-action="roll-defecto"><i class="fas fa-dice-d6"></i> Tirar dados</button>
      </div>
      {{else}}
      <div class="camc-chat-actions-row">
        {{#if dificultad}}{{#unless exito}}<button type="button" class="camc-chat-action ghost" data-camc-action="reroll-proeza"><i class="fas fa-bolt"></i> Gastar proeza · repetir dados</button>{{/unless}}{{/if}}
        {{#if (eq actor.type "personaje")}}<button type="button" class="camc-chat-action ghost camc-gm-only" data-camc-action="apply-defecto"><i class="fas fa-user-shield"></i> DJ · aplicar defecto</button>{{/if}}
      </div>
      {{/if}}
    {{/unless}}
  {{/if}}
  {{#if (eq tipo "dano_moto")}}
    <h3>{{label}}</h3>
    <div class="camc-roll-main"><div class="camc-roll-total"><span>Daño</span><b>{{roll.total}}</b></div></div>
    <div class="mods">{{formula}}</div>
  {{/if}}
  {{#if (eq tipo "dano")}}
    <h3>{{item.name}}</h3>
    <div class="camc-roll-main"><div class="camc-roll-total"><span>Daño</span><b>{{roll.total}}</b></div></div>
    <div class="mods">{{formula}}</div>
    <button type="button" class="camc-chat-action" data-camc-action="apply-damage" data-damage="{{roll.total}}">Aplicar daño</button>
  {{/if}}
  {{#if (eq tipo "iniciativa")}}
    <h3>Iniciativa</h3>
    <div class="camc-roll-main"><div class="camc-roll-total"><span>Total</span><b>{{roll.total}}</b></div></div>
    <div class="mods">{{formula}}</div>{{#if armaPreparada}}<div class="mods">Arma preparada: {{armaPreparada.label}}</div>{{/if}}
  {{/if}}
  {{#if (eq tipo "don")}}
    <h3>{{item.name}}</h3>
    <div class="dice-line">Don divino activado{{#if coste}} · coste <b>{{coste}}</b> proezas{{/if}}</div>
    <div class="mods">{{item.system.deidad}} {{#if item.system.virtud}}· {{item.system.virtud}}{{/if}}</div>
    {{#if item.system.efecto}}<p>{{item.system.efecto}}</p>{{/if}}
  {{/if}}
  {{#if (eq tipo "talento")}}
    <h3>{{item.name}}</h3>
    <div class="dice-line">Talento de cargo: <b>{{item.system.cargo}}</b></div>
    {{#if item.system.efecto}}<p>{{item.system.efecto}}</p>{{/if}}
  {{/if}}
</div>
